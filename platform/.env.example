NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Server-only key: required for validated scoring, publishing and role management.
SUPABASE_SECRET_KEY=your-server-secret-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional for CV keyword preview; required for AI interviews and simulation scoring.
GEMINI_API_KEY=
# Use a model available to your Google AI account. The base project's model is preserved.
GEMINI_MODEL=gemini-3.5-flash
