NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Server-only key: required for validated scoring, publishing and role management.
SUPABASE_SECRET_KEY=your-server-secret-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Required for R2W AI chat, CV AI analysis/image-PDF OCR, interviews and simulation scoring.
# Text CVs can use a clearly labeled keyword preview when no key is configured.
GEMINI_API_KEY=
# Use a model available to your Google AI account. The base project's model is preserved.
GEMINI_MODEL=gemini-3.5-flash

# OpenAI-compatible Responses gateway (leave blank to use Google directly).
# For Vilao, use exactly the purchased model's ID. All three are server-only.
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
# Vilao example: AI_BASE_URL=https://api.vilao.ai/v1
# AI_MODEL=sba/ag/gemini-3.8-flash
# AI_API_KEY takes precedence; when empty, the gateway uses GEMINI_API_KEY.
